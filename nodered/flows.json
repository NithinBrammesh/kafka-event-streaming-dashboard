    {
        "id": "3b3e963d9c35d56e",
        "type": "function",
        "z": "e3ca88df1a09ceff",
        "name": "function websocket format",
        "func": "// Ensure payload exists\nif (!msg.payload) {\n    return null;\n}\n\nlet data;\n\n// Convert string JSON safely\ntry {\n\n    if (typeof msg.payload === \"string\") {\n        data = JSON.parse(msg.payload);\n    } else {\n        data = msg.payload;\n    }\n\n} catch (err) {\n\n    node.warn(\"Invalid JSON received from Kafka\");\n    return null;\n}\n\n// Optional: ignore empty or invalid records\nif (!data.order_id) {\n    return null;\n}\n\n// Send clean object to websocket frontend\nmsg.payload = data;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
